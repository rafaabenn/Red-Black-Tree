  legend style={font=\small, at={(1.03,0.5)}, anchor=west}, grid=major, grid style={black!12}]
  \addplot[cabr, thick, mark=triangle*] coordinates {(1000,287.3) (10000,250.4) (20000,494.5) (100000,499.3) (1000000,1401.5)};
  \addplot[crn, thick, mark=*] coordinates {(1000,328.3) (10000,292.5) (20000,418.6) (100000,695.1) (1000000,1612.8)};
